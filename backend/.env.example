NODE_ENV=development
PORT=5000
MONGO_DB_URI=mongodb://localhost:27017
# Postgres migration (see /home/carole/.claude/plans/abundant-dreaming-flurry.md) —
# unused by the live app until Phase 12 cutover; only knex migrate/scripts read this
# during the build. Local dev: postgres://workfola_app:<password>@localhost:5433/workfola_dev
# (port 5433, not 5432 — check `pg_lsclusters` if unsure; 5432 may already be taken by
# something else, e.g. a Docker container's own Postgres, and the real install will
# auto-assign itself the next free port during setup)
DATABASE_URL=
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=2h
# Keep this short — the frontend silently renews it via /auth/refresh (30-day
# REFRESH_TOKEN_DAYS below), so a short-lived access token costs nothing in UX but
# limits how long a leaked token stays useful.
REFRESH_TOKEN_DAYS=30
UPLOAD_DIR=uploads
FRONTEND_URL=http://localhost:3000
# Cloudflare Turnstile (bot protection on login) — leave unset to disable the check
# entirely. Free keys: https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
