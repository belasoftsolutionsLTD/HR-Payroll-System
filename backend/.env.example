NODE_ENV=development
PORT=5000
MONGO_DB_URI=mongodb://localhost:27017
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
FRONTEND_URL=http://localhost:3000
